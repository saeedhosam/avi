{
  "name": "avi",
  "version": "0.0.0",
  "private": true,
  "description": "Avi — flight tracking, route network, live radar, and indoor terminal wayfinding.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
