{
  "name": "avi",
  "version": "0.0.0",
  "private": true,
  "description": "Avi — flight tracking, direct-route explorer, terminal wayfinding, and 3D cabin seat twins.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
