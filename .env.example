# ─────────────────────────────────────────────────────────────
# SkyTrack desktop — environment template
# Copy to .env.local and fill in your own values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# AeroDataBox (RapidAPI) — server-only. Used by /api/flights/* and /api/airports/*.
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# Google Maps — create a BROWSER key:
# Google Cloud Console → APIs & Services → Credentials → API key.
# Enable "Maps JavaScript API" and restrict the key to HTTP referrers
# (http://localhost:3000/*, https://your-domain/*).
# Reusing the Android MAPS_API_KEY only works if it is not restricted to Android apps.
MAPS_API_KEY=DEFAULT_MAPS_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Web App (Project settings → General → Your apps → Web app).
# These values are public client configuration, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# Optional; only present if Google Analytics is enabled for the web app.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Console → Firestore Database → Data tab → database ID.
# The Android project uses:
# ai-studio-android-skytrack-ca7ba412-a398-4ae9-99ef-a0b19d1bc846
# Leave blank to use the (default) database.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Firebase Console → Project settings → Cloud Messaging →
# Web configuration → Web Push certificates → Key pair (public key).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Console → App Check → Apps → Web app → reCAPTCHA v3 → Site key.
# Or register the domain at https://www.google.com/recaptcha/admin (v3).
# Public site key; safe to expose. Optional unless App Check is enforced.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Debug-only. Leave blank in production. Generate a debug token in
# Firebase Console → App Check → Apps → Web app → Manage debug tokens.
FIREBASE_APPCHECK_DEBUG_TOKEN=
