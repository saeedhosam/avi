# ─────────────────────────────────────────────────────────────
# SkyTrack desktop — environment template
# Copy to .env.local and fill in your own values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# AeroDataBox (RapidAPI) — server-only. Used by /api/flights/* and /api/airports/*.
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# Google Maps — kept for parity with the Android app. Optional for the bundled
# vector map; set these if you add Google basemap layers on the client.
MAPS_API_KEY=DEFAULT_MAPS_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Web App (Project settings → General → Your apps → Web app).
# These values are public client configuration, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# The Android app uses a named Firestore database. Use the same value here.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Firebase Cloud Messaging (Web Push certificate key pair → key).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase App Check (reCAPTCHA v3 site key). Optional.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
FIREBASE_APPCHECK_DEBUG_TOKEN=
