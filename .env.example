# ─────────────────────────────────────────────────────────────
# AeroQuest monorepo environment template
# Copy the relevant block into apps/web/.env.local, services/api/.env,
# and apps/mobile/.env. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Shared Supabase ──────────────────────────────────────────
SUPABASE_URL=https://uiabvbndrpscsscvwofc.supabase.co
# Secret/service-role key: gateway only. Never expose to web or mobile.
SUPABASE_SECRET_KEY=
# Public client keys (either naming convention is accepted by the apps).
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://uiabvbndrpscsscvwofc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── AeroDataBox Starter (gateway only) ───────────────────────
# Clients must never hold this key. All provider traffic goes through the
# Hetzner gateway at AVI_API_BASE_URL.
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=api.aerodatabox.com

# ── Hetzner gateway ──────────────────────────────────────────
AVI_API_BASE_URL=https://api.2-31-110-53.sslip.io
REDIS_URL=redis://redis:6379
PROVIDER_CACHE_ENABLED=true
PROVIDER_AUTH_MODE=log
UNIT_BUDGET_PER_MONTH=32000
AERODATABOX_UNITS_PER_FLIGHT=2
AERODATABOX_UNITS_PER_ROUTE=6

# ── Push ─────────────────────────────────────────────────────
# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@aeroquest.app
# Expo push access token (optional unless push security is enabled)
EXPO_ACCESS_TOKEN=

# ── Mobile (Expo public) ─────────────────────────────────────
EXPO_PUBLIC_AEROQUEST_API_URL=https://api.2-31-110-53.sslip.io
EXPO_PUBLIC_SUPABASE_URL=https://uiabvbndrpscsscvwofc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Web SEO + affiliate hooks ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://avi.codestep.org
NEXT_PUBLIC_LOUNGE_AFFILIATE_URL=
NEXT_PUBLIC_ESIM_AFFILIATE_URL=

# ── Billing / entitlements ───────────────────────────────────
BILLING_PROVIDER=manual
POLAR_API_KEY=
POLAR_PRICE_PLUS=
POLAR_PRICE_PRO=
POLAR_WEBHOOK_SECRET=
# $4.99 Single-Trip Pass: static hosted checkout + provider product id that
# grants the pass only from a verified webhook.
TRIP_PASS_CHECKOUT_URL=
TRIP_PASS_PRODUCT_ID=
TRIP_PASS_DURATION_DAYS=30
