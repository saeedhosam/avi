{
  "name": "@avi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avi provider gateway: flights, airports, weather, maps, alerts, and push.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@avi/catalog": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
