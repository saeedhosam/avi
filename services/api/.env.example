# Avi API (server-only values)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://app.2-31-110-53.sslip.io
PUBLIC_WEB_URL=http://localhost:3000

# AeroDataBox direct API — never expose this to a client.
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=api.aerodatabox.com

# Supabase service role / secret key — backend only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Redis store for shared per-user provider quotas/rate limits.
# Falls back to in-process accounting when unset.
REDIS_URL=

# ── Provider identity & quotas (P2 Track A) ──────────────────────────────
# Every provider-backed route carries the caller's Supabase access token so the
# gateway can apply per-user provider quotas.
# "log"    -> observe and log unauthenticated calls;
# "enforce" -> reject calls that lack a valid token (after a 24–48 h log window).
PROVIDER_AUTH_MODE=log

# ── Web Push delivery (P1 Track C) ───────────────────────────────
# Generate with `npx web-push generate-vapid-keys`. The public key is also
# copied into apps/web/.env.local as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
PUSH_DELIVERY_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@avi.app

# ── Billing (Polar.sh MoR; BILLING_PROVIDER=manual leaves SQL-assignment) ──
BILLING_PROVIDER=manual
# Egypt support confirmed on Polar's supported-payout list.
POLAR_API_KEY=
POLAR_PRICE_PLUS=              # Plus product/price id(s), comma-separated monthly/yearly
POLAR_PRICE_PRO=               # Pro product/price id(s), comma-separated monthly/yearly
POLAR_WEBHOOK_SECRET=          # whsec_… from Polar; Standard Webhooks since 2026-09-08
# Legacy Lemon Squeezy adapter (kept as a supported alternative provider).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PLUS=     # Plus variant ID(s), comma-separated monthly/yearly
LEMONSQUEEZY_VARIANT_PRO=      # Pro variant ID(s), comma-separated monthly/yearly
LEMONSQUEEZY_WEBHOOK_SECRET=   # whsec_… from the dashboard webhook
PUSH_BATCH_SIZE=100

# ── Watch engine ─────────────────────────────────────────────────
# Server-side lifecycle polling for watchlist flights (P0). The engine spends
# units on operational windows only, shares cached lookups across users, and
# writes status alerts to Supabase so clients no longer need to poll.
WATCH_ENGINE_ENABLED=true
WATCH_ENGINE_TICK_MS=30000
WATCH_ENGINE_SWEEPS_PER_TICK=8
WATCH_ENGINE_STARTUP_DELAY_MS=5000
WATCH_ENGINE_MAX_ROWS_PER_POLL=2000
# A tracked flight keeps occluding one plan slot this long (48h default).
WATCH_ENGINE_ACTIVE_WINDOW_MS=172800000
# One airport board call (2 units) covers every watched flight from that
# origin when at least FIDS_MIN_GROUP of them are due in the same tick.
WATCH_ENGINE_FIDS_ENABLED=true
WATCH_ENGINE_FIDS_MIN_GROUP=2

# Provider unit accounting: 2 units per AeroDataBox flight lookup, 6 per
# daily-route stats call. The monthly budget is a hard stop; default ~80% of
# the Starter 40k quota.
AERODATABOX_UNITS_PER_FLIGHT=2
AERODATABOX_UNITS_PER_ROUTE=6
UNIT_BUDGET_PER_MONTH=32000
