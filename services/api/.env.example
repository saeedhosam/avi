# Avi API (server-only values)
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://app.2-31-110-53.sslip.io
PUBLIC_WEB_URL=http://localhost:3000

# AeroDataBox direct API — never expose this to a client.
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=api.aerodatabox.com

# Supabase service role / secret key — backend only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Redis cache/rate-limit store.
REDIS_URL=
