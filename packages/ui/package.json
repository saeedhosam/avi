{
  "name": "@avi/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Avi UI and 3D cabin scene primitives.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cabin/CabinViewer3D": {
      "types": "./dist/cabin/CabinViewer3D.d.ts",
      "default": "./dist/cabin/CabinViewer3D.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('@avi/ui has no unit tests; cabin math is tested in @avi/shared')\""
  },
  "dependencies": {
    "@avi/shared": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.170"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@types/react": "^19",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
