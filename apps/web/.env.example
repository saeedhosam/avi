# ─────────────────────────────────────────────────────────────
# Avi web — environment template
# Copy to .env.local and fill in your own values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# AeroDataBox direct API — local-development fallback only.
# Production must set AVI_API_BASE_URL so all provider traffic goes through the
# gateway (cache, rate limits, and unit accounting in one place).
AERODATABOX_API_KEY=DEFAULT_AERODATABOX_KEY
AERODATABOX_API_HOST=api.aerodatabox.com

# Avi API (provider gateway).
AVI_API_BASE_URL=https://api.2-31-110-53.sslip.io

# Supabase (public client configuration, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://uiabvbndrpscsscvwofc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push (public VAPID application server key) — generate with:
#   npx web-push generate-vapid-keys
# The private half belongs in services/api/.env as VAPID_PRIVATE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Canonical site origin for metadata, sitemap, and share links.
NEXT_PUBLIC_SITE_URL=https://avi.codestep.org

# Contextual affiliate hooks (no banner ads). Leave empty to use safe defaults.
NEXT_PUBLIC_LOUNGE_AFFILIATE_URL=
NEXT_PUBLIC_ESIM_AFFILIATE_URL=

