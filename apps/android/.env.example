# Avi Android development configuration.
# Copy to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=https://uiabvbndrpscsscvwofc.supabase.co
SUPABASE_PUBLISHABLE_KEY=DEFAULT_SUPABASE_PUBLISHABLE_KEY

# Avi gateway — all flight lookups flow through this host (no provider keys
# are embedded in the APK, so no AeroDataBox secrets needed here).
AVI_API_BASE_URL=https://api.codestep.org

# Web OAuth client ID from Google Cloud Console (used by Credential Manager).
GOOGLE_WEB_CLIENT_ID=DEFAULT_GOOGLE_WEB_CLIENT_ID
