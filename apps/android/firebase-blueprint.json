{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information authenticated via Google Sign-In.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique Firebase Auth UID." },
        "displayName": { "type": "string", "description": "User full display name." },
        "email": { "type": "string", "description": "User Google account email." },
        "photoUrl": { "type": "string", "description": "Avatar photo URL if available." },
        "homeAirport": { "type": "string", "description": "Default home airport code (e.g. JFK)." },
        "themePreference": { "type": "string", "description": "SYSTEM, LIGHT, or DARK." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update timestamp." }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "UserTrackedFlight": {
      "title": "UserTrackedFlight",
      "description": "Flight actively tracked and synced to Firestore for the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID or flight identifier." },
        "userId": { "type": "string", "description": "Owner user UID." },
        "flightNumber": { "type": "string", "description": "Flight number (e.g., AA 100)." },
        "airline": { "type": "string", "description": "Airline name." },
        "airlineCode": { "type": "string", "description": "Airline IATA code." },
        "originCode": { "type": "string", "description": "Departure airport code." },
        "originCity": { "type": "string", "description": "Departure airport city." },
        "destCode": { "type": "string", "description": "Arrival airport code." },
        "destCity": { "type": "string", "description": "Arrival airport city." },
        "status": { "type": "string", "description": "Current flight status." },
        "customNotes": { "type": "string", "description": "Personal flight notes or seat number." },
        "isFavorite": { "type": "boolean", "description": "Whether flight is favorited." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp." }
      },
      "required": ["userId", "flightNumber", "airline", "originCode", "destCode", "status", "createdAt", "updatedAt"]
    },
    "UserFlightAlert": {
      "title": "UserFlightAlert",
      "description": "Real-time or scheduled flight status notification alert for the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Alert unique ID." },
        "userId": { "type": "string", "description": "Owner user UID." },
        "flightNumber": { "type": "string", "description": "Target flight number." },
        "alertType": { "type": "string", "description": "GATE_CHANGE, DELAY, BOARDING, or CANCELLATION." },
        "title": { "type": "string", "description": "Alert title." },
        "message": { "type": "string", "description": "Alert detailed message." },
        "isRead": { "type": "boolean", "description": "Read status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Alert creation timestamp." }
      },
      "required": ["userId", "flightNumber", "alertType", "title", "message", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document owned strictly by the authenticated user."
    },
    "/users/{userId}/trackedFlights/{flightId}": {
      "schema": { "$ref": "#/entities/UserTrackedFlight" },
      "description": "Tracked flight records owned by the authenticated user."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/UserFlightAlert" },
      "description": "Notification alerts owned by the authenticated user."
    }
  }
}
