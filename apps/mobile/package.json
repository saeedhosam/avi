{
  "name": "@avi/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "pnpm --filter @avi/shared build && pnpm --filter @avi/ui build",
    "start": "expo start",
    "android": "pnpm --filter @avi/shared build && pnpm --filter @avi/ui build && expo start --android",
    "ios": "pnpm --filter @avi/shared build && pnpm --filter @avi/ui build && expo start --ios",
    "build": "node scripts/build-info.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node -e \"console.log('mobile unit coverage lives in @avi/shared')\""
  },
  "dependencies": {
    "@avi/catalog": "workspace:*",
    "@avi/shared": "workspace:*",
    "@avi/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "^58.0.25",
    "expo-camera": "^58.0.14",
    "expo-constants": "^58.0.16",
    "expo-device": "^58.0.5",
    "expo-gl": "^58.0.4",
    "expo-linking": "^58.0.17",
    "expo-location": "^58.0.22",
    "expo-notifications": "^58.1.9",
    "expo-router": "^58.0.31",
    "expo-sensors": "^58.0.5",
    "expo-status-bar": "^58.0.5",
    "nativewind": "^4.2.7",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-worklets": "^0.13.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/three": "^0.187.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
