{
  "expo": {
    "name": "AeroQuest",
    "slug": "aeroquest",
    "scheme": "aeroquest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AeroQuest uses the camera to scan boarding passes and size carry-on bags."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AeroQuest uses your location to orient the terminal map and in-flight route."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22d3ee"
        }
      ]
    ],
    "experiments": {},
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.aeroquest.mobile"
    },
    "android": {
      "package": "app.aeroquest.mobile",
      "edgeToEdgeEnabled": true
    }
  }
}
